# Production Environment Variables Template
# Copy this file to .env.production and fill in real values before deployment

# Google Analytics
# Get your Measurement ID from: https://analytics.google.com/
# Example: G-ABC123XYZ
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Tag Manager
# Get your Container ID from: https://tagmanager.google.com/
# Example: GTM-ABC1234
NEXT_PUBLIC_GTM_ID=

# Google Search Console Verification
# Get your verification code from: https://search.google.com/search-console/
# This is optional - you can also verify via HTML file or DNS
NEXT_PUBLIC_GSC_VERIFICATION=

# Resend Email Service (REQUIRED)
# Get your API key from: https://resend.com/api-keys
# Example: re_123abc456def789ghi012jkl345mno678
RESEND_API_KEY=

# Email Configuration (Optional overrides)
CONTACT_EMAIL_TO=connect@starboardrealtors.co.in
CONTACT_EMAIL_FROM=Starboard Realtors <noreply@starboardrealtors.co.in>
